# Local configuration reference. Copy values into shell environment or app-specific .env files.
# Do not commit real credentials.

# Backend CORS origin (defaults to the Vite development server)
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Used only with the backend's `mysql` Spring profile.
DB_URL=jdbc:mysql://localhost:3306/challanyatri
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Reserved for the approved Phase 2 JWT implementation; do not use this placeholder as a real secret.
JWT_SECRET=replace_with_a_secure_local_secret_in_phase_2

# Frontend backend API base URL
VITE_API_BASE_URL=http://localhost:8080/api
