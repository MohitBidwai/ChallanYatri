# Spring profile and MySQL connection values for local development.
# Export these values in your shell or IDE run configuration; Spring Boot does not load .env files by itself.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://localhost:3306/challanyatri
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
